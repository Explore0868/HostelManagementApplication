# ===================================================================
# Backend Environment Variables Template (Render + Hosted MySQL)
# ===================================================================
# Copy this file to .env for local testing or configure these
# environment variables in the Render Dashboard (Web Service > Environment).
# Never commit real passwords or tokens to version control.

# Server Port (Render sets this dynamically; defaults to 8080)
PORT=8080

# Hosted MySQL Database Credentials
# Example: jdbc:mysql://your-mysql-host.aivencloud.com:12345/defaultdb?sslMode=REQUIRED
SPRING_DATASOURCE_URL=jdbc:mysql://<your-mysql-host>:<your-mysql-port>/<your-database-name>?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<your-mysql-username>
SPRING_DATASOURCE_PASSWORD=<your-mysql-password>

# Database Connection Pool Settings (HikariCP)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Hibernate DDL Mode (Use 'update' for managed schema evolution or 'validate' for strict schemas)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# CORS Allowed Origins (Comma-separated list including your Vercel domain and local dev)
# Example: https://hostel-app.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://<your-vercel-frontend-domain>.vercel.app,http://localhost:5173

# JWT Secret Key: Must be a Base64-encoded string of at least 32 bytes (256 bits).
# Generate in bash/PowerShell with: openssl rand -base64 32
JWT_SECRET=<your-base64-encoded-32-byte-secret>
JWT_EXPIRATION_SECONDS=3600

# Initial Admin Bootstrap (Set enabled=true once to create first admin, then turn false)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
