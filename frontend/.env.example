# ===================================================
# Frontend Environment Variables Template (Vercel)
# ===================================================
# Set this in your Vercel Project Settings > Environment Variables:
# Key: VITE_API_BASE_URL
# Value: https://<your-render-backend-service-url>.onrender.com/api
#
# NOTE: In local development, this defaults to http://localhost:8080/api
VITE_API_BASE_URL=https://your-render-backend-name.onrender.com/api
